PORT=3005
NEXT_PUBLIC_NODE_ENV="development"
# NEXT_PUBLIC_APP_URL=""

# Next Auth
AUTH_SECRET="dummy_auth_secret"
AUTH_DISCORD_ID="dummy_discord_id"
AUTH_DISCORD_SECRET="dummy_discord_secret"
AUTH_GOOGLE_ID="dummy_google_id"
AUTH_GOOGLE_SECRET="dummy_google_secret"

# DB Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/second-brain"
CRON_SECRET="dummy_cron_secret"

# Analytics
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# AI Services
# B.ai (GLM). OpenAI-compatible endpoint.
BAI_API_KEY=""
GROQ_API_KEY=""
GOOGLE_AI_STUDIO_API_KEY=""
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
XAI_API_KEY=""

# Remote MCP (/api/mcp). Personal-use clients authenticate with static API
# keys created in Preferences (stored hashed; no env config needed).
# Production OAuth tokens come from the configured authorization server
# (see docs/mcp-adr.md).
MCP_OAUTH_ISSUER=""
MCP_OAUTH_AUDIENCE="second-brain-mcp"
MCP_OAUTH_JWKS_URI=""
MCP_OAUTH_SECRET=""
# Optional staged-rollout allowlist (comma-separated user IDs). Unset/empty
# = MCP available to all authenticated users.
MCP_ENABLED_USERS=""

# client side variables
NEXT_PUBLIC_APP_URL="https://secondbrainets.mohamedhi.com"
