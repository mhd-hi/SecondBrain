# Used only by `bun run test:integration`. Keeps integration tests off the
# dev port/database — point DATABASE_URL at a real, disposable Postgres
# database dedicated to tests (migrate it before running the suite).
PORT=3006
DATABASE_URL="postgresql://postgres:password@localhost:5432/second-brain-test"

AUTH_SECRET="integration-test-secret"
AUTH_DISCORD_ID="integration-test"
AUTH_DISCORD_SECRET="integration-test"
AUTH_GOOGLE_ID="integration-test"
AUTH_GOOGLE_SECRET="integration-test"
CRON_SECRET="integration-test"
